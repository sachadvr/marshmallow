                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Error"
                                }
                            }
                        },
                        "links": {}
                    }
                },
                "summary": "Retrieves a Text resource.",
                "description": "Retrieves a Text resource.",
                "parameters": []
            },
