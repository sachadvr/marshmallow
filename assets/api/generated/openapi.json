                            "application/json": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "$ref": "#/components/schemas/File-file.read"
                                    }
                                }
                            }
                        }
                    }
                },
                "summary": "Retrieves the collection of File resources.",
                "description": "Retrieves the collection of File resources.",
                "parameters": []
            }
        },
        "/api/files/{id}": {
            "get": {
                "operationId": "api_files_id_get",
                "tags": [
