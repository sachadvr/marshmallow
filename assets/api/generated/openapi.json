                        "description": "Not found",
                        "content": {
                            "application/problem+json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Error"
                                }
                            },
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Error"
                                }
                            }
                        },
                        "links": {}
                    }
                },
                "summary": "Replaces the Text resource.",
                "description": "Replaces the Text resource.",
                "parameters": [],
                "requestBody": {
                    "description": "The updated Text resource",
                    "content": {
